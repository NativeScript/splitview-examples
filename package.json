{
  "name": "splitview-examples",
  "main": "./src/main.ts",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.0.0",
    "@angular/common": "~21.0.0",
    "@angular/compiler": "~21.0.0",
    "@angular/core": "~21.0.0",
    "@angular/forms": "~21.0.0",
    "@angular/platform-browser": "~21.0.0",
    "@angular/platform-browser-dynamic": "~21.0.0",
    "@angular/router": "~21.0.0",
    "@nativescript/angular": "21.0.0-rc.3",
    "@nativescript/core": "^9.0.10",
    "@valor/nativescript-websockets": "^2.0.2",
    "rxjs": "~7.8.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.0.0",
    "@angular/compiler-cli": "~21.0.0",
    "@nativescript/ios": "9.0.2",
    "@nativescript/tailwind": "^2.1.0",
    "@nativescript/types": "~9.0.0",
    "@nativescript/vite": "^1.0.5",
    "@nativescript/webpack": "~5.0.28",
    "@ngtools/webpack": "~21.0.0",
    "concurrently": "^9.0.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "~3.4.0",
    "typescript": "~5.9.0",
    "wait-on": "^9.0.0"
  },
  "scripts": {
    "dev:ios": "concurrently -k -n vite,ns 'npm run dev:server:ios' 'wait-on tcp:5173 && npm run ios'",
    "dev:android": "concurrently -k -n vite,ns 'npm run dev:server:android' 'wait-on tcp:5173 && npm run android'",
    "dev:server:ios": "VITE_DEBUG_LOGS=1 vite serve -- --env.ios --env.hmr",
    "dev:server:android": "VITE_DEBUG_LOGS=1 vite serve -- --env.android --env.hmr",
    "ios": "VITE_DEBUG_LOGS=1 ns debug ios",
    "android": "VITE_DEBUG_LOGS=1 ns debug android",
    "postinstall": "patch-package"
  }
}
